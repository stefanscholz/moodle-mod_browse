{{!
    @template mod_browse/steps_panel

    The list of steps of a browse activity with the current user's progress.

    Example context (json):
    {
        "cmid": 12,
        "hassteps": true,
        "cancomplete": true,
        "progresstext": "1 of 2 steps completed",
        "progresspercent": 50,
        "steps": [
            {
                "id": 1,
                "number": 1,
                "title": "Open the survey",
                "description": "<p>Follow the link and start the survey.</p>",
                "completed": true,
                "locked": false,
                "ismanual": false,
                "islink": true,
                "iscallback": false,
                "manualinteractive": false,
                "gourl": "https://moodle.example.com/mod/browse/go.php?id=12&step=1",
                "linktarget": "_blank"
            }
        ]
    }
}}
<div data-region="mod_browse-steps-panel">
    <h3 class="h5">{{#str}} steps, mod_browse {{/str}}</h3>
    {{#hassteps}}
        <p class="mb-1" data-region="mod_browse-progress-text">{{progresstext}}</p>
        <div class="progress mb-3" style="height: 0.5rem;">
            <div class="progress-bar" role="progressbar" style="width: {{progresspercent}}%;"
                aria-valuenow="{{progresspercent}}" aria-valuemin="0" aria-valuemax="100"
                aria-label="{{progresstext}}"></div>
        </div>
        <ol class="list-unstyled mb-0">
            {{#steps}}
                <li class="mod_browse-step border rounded p-2 mb-2 {{#completed}}border-success{{/completed}}"
                    data-region="mod_browse-step" data-stepid="{{id}}">
                    <div class="d-flex align-items-start">
                        {{#ismanual}}
                            <div class="form-check me-2 mr-2">
                                <input type="checkbox" class="form-check-input" id="mod_browse-step-{{id}}"
                                    data-mod-browse-toggle data-stepid="{{id}}"
                                    {{#completed}}checked{{/completed}}
                                    {{^manualinteractive}}disabled{{/manualinteractive}}
                                    aria-label="{{#str}} markdone, mod_browse, {{title}} {{/str}}">
                            </div>
                        {{/ismanual}}
                        <div class="flex-grow-1">
                            <span class="fw-bold font-weight-bold">
                                {{#ismanual}}
                                    <label for="mod_browse-step-{{id}}" class="mb-0 fw-bold font-weight-bold">{{number}}. {{title}}</label>
                                {{/ismanual}}
                                {{^ismanual}}{{number}}. {{title}}{{/ismanual}}
                            </span>
                            {{#completed}}
                                <span class="badge bg-success badge-success ms-1 ml-1">{{#str}} stepdone, mod_browse {{/str}}</span>
                            {{/completed}}
                            {{#locked}}
                                <span class="badge bg-secondary badge-secondary ms-1 ml-1">{{#str}} steplocked, mod_browse {{/str}}</span>
                            {{/locked}}
                            {{#description}}
                                <div class="small">{{{description}}}</div>
                            {{/description}}
                            {{#islink}}
                                {{^locked}}
                                    <a href="{{gourl}}" target="{{linktarget}}" class="btn btn-sm btn-outline-primary mt-1"
                                        data-action="mod_browse-visit" data-stepid="{{id}}">
                                        {{#str}} stepvisit, mod_browse {{/str}}
                                    </a>
                                {{/locked}}
                            {{/islink}}
                            {{#iscallback}}
                                {{^completed}}
                                    <div class="small text-muted">{{#str}} completedautomatically, mod_browse {{/str}}</div>
                                {{/completed}}
                            {{/iscallback}}
                        </div>
                    </div>
                </li>
            {{/steps}}
        </ol>
    {{/hassteps}}
    {{^hassteps}}
        <p class="text-muted">{{#str}} nosteps, mod_browse {{/str}}</p>
    {{/hassteps}}
</div>
